{
  "name": "jonghwa-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --port 4173",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}' scripts/*.mjs next.config.ts",
    "test": "node --import tsx --test tests/*.test.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
